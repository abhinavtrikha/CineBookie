PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Database configuration:
# By default, CineBookie uses local persistent SQLite (cinebookie.db) with zero external setup needed.
# To connect to a PostgreSQL instance instead, set USE_POSTGRES=true and configure DATABASE_URL:
USE_POSTGRES=false
DATABASE_URL=postgresql://postgres:password@localhost:5432/cinebookie
